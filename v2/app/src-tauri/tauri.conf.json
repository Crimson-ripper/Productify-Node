{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Productify Node",
  "version": "2.0.0",
  "identifier": "com.productifynow.node",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Productify Node",
        "width": 880,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Productify",
    "category": "Utility",
    "shortDescription": "Rent out your GPU on productifynow.com",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../../agent/dist/productify-agent.exe": "productify-agent.exe" },
    "windows": {
      "nsis": { "installMode": "perMachine", "installerHooks": "./installer-hooks.nsh" }
    }
  }
}
